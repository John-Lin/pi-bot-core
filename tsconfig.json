{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,
    "types": ["bun"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true
  },
  "include": [
    "src/**/*",
    "tests/tool-schemas.test.ts",
    "tests/agent-extensions.test.ts",
    "tests/mcp-config.test.ts",
    "tests/mcp-oauth.test.ts",
    "tests/helpers/**/*",
    "tests/fixtures/**/*"
  ]
}
